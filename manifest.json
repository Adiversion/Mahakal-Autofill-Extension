{
  "manifest_version": 3,
  "name": "Mahakal Darshan Autofill — Bhasma Aarti & Shighra Darshan Helper",
  "short_name": "Mahakal Autofill",
  "description": "Free 1-click devotee form autofill for Shri Mahakaleshwar Temple (Bhasma Aarti & Shighra Darshan) with encrypted local family vault.",
  "version": "1.3.2",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mahakal Darshan Autofill",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
